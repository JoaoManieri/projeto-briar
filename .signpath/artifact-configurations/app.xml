<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath, configuração de artefato "app": o Briar.exe de dentro do instalador.
     O artefato vem do passo app-unsigned de .github/workflows/build.yml (zip com Briar.exe na raiz). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Briar.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
