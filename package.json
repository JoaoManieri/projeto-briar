{
  "name": "briar",
  "version": "0.6.2",
  "productName": "Briar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "app": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist": "npm run build && electron-builder --linux AppImage deb --win nsis portable --publish never"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "description": "Briar — cliente Git local (estilo GitKraken) para o time da Hipona Studios.",
  "author": "Hipona Studios",
  "homepage": "https://github.com/JoaoManieri/projeto-briar",
  "license": "MIT",
  "main": "electron/main.mjs",
  "desktopName": "briar.desktop",
  "build": {
    "appId": "br.com.hipona.briar",
    "productName": "Briar",
    "publish": {
      "provider": "github",
      "owner": "JoaoManieri",
      "repo": "projeto-briar"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Hipona Studios",
      "syncDesktopName": true,
      "artifactName": "Briar-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Briar-Setup.exe"
    },
    "portable": {
      "artifactName": "Briar-Portable.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoaoManieri/projeto-briar.git"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
